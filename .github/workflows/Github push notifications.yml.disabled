name: Push Notification

on:
  push:
    branches:
      - main
      - dev

jobs:
  notify:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Notify push using Discord webhook
        env:
          DISCORD_WEBHOOK_URLS: ${{ secrets.DISCORD_WEBHOOKS }}
        run: |
          chmod +x .github/workflows/src/push_notifications.sh
          .github/workflows/src/push_notifications.sh